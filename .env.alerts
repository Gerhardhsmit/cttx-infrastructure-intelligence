# CTTX Alert System Configuration
# Copy these to your .env file to enable email alerts

# Email Configuration
ALERT_EMAIL=gerhardcttx@gmail.com

# Gmail SMTP Configuration
# Generate app password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gerhardcttx@gmail.com
SMTP_PASS=your_app_password_here

# Alert Schedule (CRON - all in UTC)
# Daily Standup: 06:00 UTC = 08:00 SAST, weekdays
# Budget Check: Every 12 hours
# Deadline Check: Every 6 hours
# Client Follow-up: 09:00 UTC = 11:00 SAST, daily

# Alerts sent:
# 1. Daily Standup (08:00 SAST, weekdays)
# 2. Budget Alert (when costs > 80% of contract)
# 3. Deadline Warning (when phase overdue)
# 4. Client Follow-up Reminder (7+ days no contact)
